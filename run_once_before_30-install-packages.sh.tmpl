#!/bin/bash

# Ajo vain Ubuntulla / Debianilla / Pop!_OS:lla
{{ if eq .chezmoi.os "linux" -}}
{{ if has .chezmoi.osRelease.id (list "pop" "ubuntu" "debian") -}}

# Apufunktio valinnalle. Lukee syötteen suoraan päätteeltä (/dev/tty).
prompt_brew_install() {
	echo "--------------------------------------------------"
		echo "Homebrewta ei löytynyt. Valitse asennustapa:"
		echo "1) Yleinen / Järjestelmänlaajuinen (/home/linuxbrew/.linuxbrew - vaatii sudo-oikeudet)"
		echo "2) Käyttäjän kotihakemisto ($HOME/.linuxbrew - ei vaadi sudoa)"
		echo "3) Älä asenna Homebrewta"
		echo "--------------------------------------------------"

		local choice
		while true; do
			read -r -p "Valitse vaihtoehto [1-3]: " choice < /dev/tty
	case "$choice" in
				1) return 1 ;;
				2) return 2 ;;
				3) return 3 ;;
				*) echo "Virheellinen valinta. Syötä 1, 2 tai 3." ;;
				esac
					done
}

# Määritetään mahdolliset polut
BREW_GLOBAL="/home/linuxbrew/.linuxbrew"
BREW_LOCAL="$HOME/.linuxbrew"
BREW_PACKAGES="ov pdfcpu age bat eza btop"

# --- 1. Alkutarkistus: Onko Homebrew jo asennettu? ---
if command -v brew &> /dev/null || [ -d "$BREW_GLOBAL" ] || [ -d "$BREW_LOCAL" ]; then
echo "Homebrew on jo asennettu järjestelmään. Asennetaan varmuudeksi tietyt ohjelmat."
brew install "$BREW_PACKAGES"

else
# --- 2. Kysytään asennustapa vain, jos Homebrewta ei ole vielä asennettu ---
prompt_brew_install
INSTALL_TYPE=$?

case $INSTALL_TYPE in
1)
echo "Asennetaan Homebrew järjestelmänlaajuisesti ($BREW_GLOBAL)..."
NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
;;
2)
echo "Asennetaan Homebrew kotihakemistoon ($BREW_LOCAL)..."
mkdir -p "$BREW_LOCAL"
mkdir -p $BREW_LOCAL/bin
git clone https://github.com/Homebrew/brew $BREW_LOCAL
#NONINTERACTIVE=1 HOMEBREW_PREFIX="$BREW_LOCAL" /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
;;
3)
echo "Ohitetaan Homebrewn asennus."
;;
esac
fi

# --- 3. Ladataan brew ympäristömuuttujiin loppuskriptin ajaksi ---
if [ -d "$BREW_LOCAL/bin" ] && [ -x "$BREW_LOCAL/bin/brew" ]; then
eval "$("$BREW_LOCAL/bin/brew" shellenv)"
elif [ -d "$BREW_GLOBAL/bin" ] && [ -x "$BREW_GLOBAL/bin/brew" ]; then
eval "$("$BREW_GLOBAL/bin/brew" shellenv)"
fi

# --- 4. Asennetaan paketit, jos brew on käytettävissä ---
if command -v brew &> /dev/null; then
echo "Homebrew valmiina käyttöön: $(brew --version | head -n 1)"
echo "Asennetaan paketteja (ov, pdfcpu)..."
brew install "$BREW_PACKAGES"
else
echo "Homebrew ei ole käytettävissä (ohitettu tai asennus epäonnistui)."
fi

{{ end -}}
{{ end -}}
