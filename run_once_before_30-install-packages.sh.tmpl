#!/bin/bash

# Ajo vain Ubuntulla / Debianilla / Pop!_OS:lla
{{ if eq .chezmoi.os "linux" -}}
{{ if has .chezmoi.osRelease.id (list "pop" "ubuntu" "debian") -}}
# --- Homebrew ---
if command -v brew &> /dev/null; then
    echo "Homebrew on jo asennettu."
else
    echo "Homebrewta ei löytynyt, asennetaan..."
    # Asennetaan Brew ilman interaktiivisia kysymyksiä NONINTERACTIVE=1 avulla
    NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"

    # Ladataan brew ympäristömuuttujiin loppuskriptin ajaksi
    if [ -d "/home/linuxbrew/.linuxbrew" ]; then
        eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
    elif [ -d "$HOME/.linuxbrew" ]; then
        eval "$("$HOME/.linuxbrew/bin/brew" shellenv)"
    fi
fi

# Tarkistetaan asennuksen onnistuminen
if command -v brew &> /dev/null; then
    echo "Homebrew valmiina käyttöön: $(brew --version | head -n 1)"
brew install ov pdfcpu
else
    echo "Varoitus: Homebrewn asennus epäonnistui tai brew-komentoa ei löytynyt PATHista."
fi

{{ end -}}
{{ end -}}
