#!/bin/bash

# Ajo vain Ubuntulla / Debianilla
{{ if eq .chezmoi.os "linux" -}}
{{   if eq .chezmoi.osRelease.id "pop" "ubuntu" "debian" -}}

# Tarkistetaan onko Discord jo asennettu Flatpakina
if ! flatpak list | grep -q "com.discordapp.Discord"; then
    echo "Asennetaan Discord (Flatpak)..."
    flatpak install --user -y flathub com.discordapp.Discord
else
    echo "Discord on jo asennettu."
fi

if command -v element-desktop &> /dev/null; then
    echo "element-desktop on asennettu."
else
{

    echo "element-desktop ei ole asennettu."
sudo apt install -y wget apt-transport-https
sudo wget -O /usr/share/keyrings/element-io-archive-keyring.gpg https://packages.element.io/debian/element-io-archive-keyring.gpg
echo "deb [signed-by=/usr/share/keyrings/element-io-archive-keyring.gpg] https://packages.element.io/debian/ default main" | sudo tee /etc/apt/sources.list.d/element-io.list

sudo apt update

sudo apt install -y element-desktop
}
fi

echo "Asennetaan peruspaketit (APT)..."
sudo apt update
sudo apt install -y \
    curl \
    git \
    build-essential \
    htop \
fish \
	vim zsh rsync tree btop age tmux curl bat eza \
zsh-autosuggestions zsh-syntax-highlighting

# Set fish as default shell if not already
if [ "$(getent passwd "$USER" | cut -d: -f7)" != "$(which fish)" ]; then
  echo "Setting fish as default shell..."
  chsh -s "$(which fish)"
else
	echo "Fish already default shell"
fi

